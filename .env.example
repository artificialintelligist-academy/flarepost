# Incoming webhook for the incidents channel, see the course for how to create one.
# Leave it empty to run Flarepost without Slack.
FLAREPOST_SLACK_WEBHOOK_URL=

# API key for the copilot's LLM, from console.anthropic.com. Only the copilot uses it.
ANTHROPIC_API_KEY=

# Token for GitHub's MCP server, so the copilot can read the services' repositories.
# Create a fine-grained token with "Public repositories" access and no extra permissions.
# Leave it empty to run the copilot without GitHub.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Organization or user that owns the services' repositories.
# FLAREPOST_GITHUB_OWNER=artificialintelligist-academy

# Key that every Flarepost instance shares to seal MRTR requestState.
# Needed only with more than one instance. Create one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
FLAREPOST_REQUEST_STATE_KEY=

# Redis that shares subscription events between instances.
# Needed only with more than one instance, e.g. redis://127.0.0.1:6379/0
FLAREPOST_REDIS_URL=

# Token every request to the HTTP server must carry, as
# "Authorization: Bearer <token>". Leave it empty to run without one, which
# is only safe over stdio. Create one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
FLAREPOST_TOKEN=